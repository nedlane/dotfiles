[Unit]
Description=Persistent tmux session 'main'
Documentation=man:tmux(1)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent and never attaches (attaching has no TTY at boot). Creates 'main'
# only if it isn't already there. No ExecStop: a persistent session must not
# die just because this helper unit is stopped/restarted — only on VM shutdown.
# Starting the server here (not lazily from the first ssh login) also means
# continuum's restore-from-scratch runs with no client attached, so its
# kill of the bootstrap session can't boot anyone off.
ExecStart=/bin/sh -c '/usr/bin/tmux has-session -t =main 2>/dev/null || /usr/bin/tmux new-session -d -s main'
# Never let systemd kill the (shared) tmux server; we only ever add a session.
KillMode=process

[Install]
WantedBy=default.target
